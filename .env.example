# Copy this file to `.env` and fill in your real values.
# Pick ONE provider — uncomment the block you want and fill in the API key.

# ─── Provider 1: Google Gemini (free tier) ─────────────────────────
# Get a free key at https://aistudio.google.com/apikey
OPENAI_API_KEY=your_gemini_key_here
OPENAI_MODEL=gemini-flash-latest
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# ─── Provider 2: OpenAI (paid, $5 minimum) ─────────────────────────
# Get a key at https://platform.openai.com/api-keys
# OPENAI_API_KEY=your_openai_key_here
# OPENAI_MODEL=gpt-4.1-mini
# OPENAI_BASE_URL=
